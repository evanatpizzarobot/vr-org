#!/bin/sh
# VR.org is a PUBLIC repo. Two hard gates before any commit:
#   1. No API keys / secrets in staged changes.
#   2. No markdown or spec/design/plan files (those stay local only).

# --- Gate 1: secret patterns -------------------------------------------------
# Real secret prefixes always appear at the start of a token (preceded by
# whitespace, quote, =, etc.), never embedded in a word. The (^|[^A-Za-z0-9])
# prefix below kills false positives like "Sapphire_Pulse_..." matching re_.
KEY_PATTERNS="(^|[^A-Za-z0-9])(sk-ant-[a-zA-Z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|re_[a-zA-Z0-9_-]{20,}|ghp_[0-9A-Za-z]{36}|xox[baprs]-[0-9A-Za-z-]{10,}|AKIA[0-9A-Z]{16})|-----BEGIN [A-Z ]*PRIVATE KEY-----"
if git diff --cached | grep -qE "$KEY_PATTERNS"; then
  echo "COMMIT BLOCKED: possible API key or secret detected in staged changes."
  echo "Remove the value, use process.env or a platform secret, then retry."
  exit 1
fi

# --- Gate 2: docs / specs must not enter a public repo -----------------------
DOCS=$(git diff --cached --name-only --diff-filter=AM | grep -iE '\.(md|markdown)$|(^|/)(SPEC|specs?|docs?|design|plans)/' || true)
if [ -n "$DOCS" ]; then
  echo "COMMIT BLOCKED: documentation/spec files cannot enter this PUBLIC repo."
  echo "These stay local only (Pizza Robot Studios public-repo rule):"
  echo "$DOCS" | sed 's/^/  - /'
  echo "Unstage them: git restore --staged <file>"
  exit 1
fi

exit 0
