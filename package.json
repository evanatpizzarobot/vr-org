{
  "name": "vr-org",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/validate-articles.mjs && node scripts/check-author-rotation.mjs --recent 12 && node scripts/check-outbound-links.mjs --recent 20",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "test": "node --test \"test/*.test.mjs\"",
    "check:images": "node scripts/check-article-images.mjs",
    "check:image-reuse": "node scripts/check-image-reuse.mjs",
    "check:deals": "node scripts/check-deal-links.mjs",
    "check:category-products": "node scripts/check-category-products.mjs",
    "check:rotation": "node scripts/check-author-rotation.mjs",
    "check:same-date": "node scripts/check-same-date-byline.mjs",
    "check:articles": "node scripts/validate-articles.mjs",
    "check:release-dates": "node scripts/check-release-dates.mjs",
    "check:ad-coverage": "node scripts/check-ad-coverage.mjs",
    "check:youtube": "node scripts/check-youtube-ids.mjs",
    "deals:publish": "node scripts/refresh-deals.mjs",
    "audit:pages": "node scripts/audit-pages.mjs",
    "thumbs:toplists": "node scripts/generate-toplist-thumbs.mjs",
    "gsc:mine": "node scripts/gsc-striking-distance.mjs",
    "check:links": "node scripts/check-outbound-links.mjs"
  },
  "dependencies": {
    "mcp-handler": "^1.1.0",
    "next": "15.5.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "twitter-api-v2": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.14",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
