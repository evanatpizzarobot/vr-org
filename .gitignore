# data: only editorial/content JSON is tracked. Runtime state written by the
# engine (featured.json, feed-cache.json) and the bot (posted-tweets.json,
# bot-health.json) lives on the VPS only. Draft article files are never tracked.
data/*
!data/articles.json
!data/top-lists.json
!data/events.json
!data/deals.json
!data/page-maintenance.json
!data/release-dates.json
!data/category-products.json
!data/ad-placements.json
!data/vr-creators.json

# duplicate nested dir
vr-org/

# Local-only docs and specs (Pizza Robot Studios public-repo rule)
